rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().status == 'active';
    }
    function isAdmin() { return isActive() && profile().role == 'admin'; }

    // 新規登録者は pending で作成。利用開始・権限変更は管理者のみ。
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','office','email','status','role','favs','createdAt'])
        && request.resource.data.office is string
        && request.resource.data.office.size() > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'member';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && (!('office' in resource.data) || resource.data.office == '' || resource.data.office == null)
            && request.resource.data.office is string
            && request.resource.data.office.size() > 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['office']))
        || (isActive() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favs']));
      allow delete: if isAdmin();
    }

    // 学校マスター・見取図・写真・スタンプは管理者だけが直接変更可能。
    match /schools/{sid} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
      match /points/{pid} {
        allow read: if isActive();
        allow create, update, delete: if isAdmin();
      }
    }

    // 一般ユーザーは審査申請のみ作成できる。公開データの直接変更は禁止。
    match /requests/{rid} {
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.office == profile().office
        && request.resource.data.status == 'pending'
        && request.resource.data.action in ['point-create','point-update','point-delete','point-position','point-report','stamps','school-fields']
        && request.resource.data.schoolId is string
        && request.resource.data.data is map
        && request.resource.data.keys().hasOnly(['action','schoolId','pointId','data','uid','office','userName','status','createdAt']);
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /notices/{nid} {
      allow read: if isActive();
      allow write: if isAdmin();
    }
  }
}
